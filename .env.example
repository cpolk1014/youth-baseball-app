# Copy to .env.local. Leave empty to run on browser-only (local) data.
# See docs/supabase-setup.md.
# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for reading uploaded schedules (Practice -> Import from a file).
# Server-only: never prefix with NEXT_PUBLIC_. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# ElevenLabs (elevenlabs.io) for Gameday PA: AI walk-up songs, the announcer's voice and
# soundboard sounds. Server-only. The voice ID is optional (pick a stadium-announcer voice
# from ElevenLabs' Voice Library; leave empty for the default).
ELEVENLABS_API_KEY=
ELEVENLABS_ANNOUNCER_VOICE_ID=

# Stripe (stripe.com) for paying for a season: clubs ($99/team) and single teams ($129).
# Server-only. Use test keys (sk_test_...) until you're ready to take real payments.
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe for https://<your site>/api/stripe/webhook
# (event: checkout.session.completed and checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=
# Supabase service role key (Project Settings -> API). Server-only, used only to record
# payments Stripe confirms. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=
