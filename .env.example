# Copy to .env.local. Leave empty to run on browser-only (local) data.
# See docs/supabase-setup.md.
# Supabase project settings (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API key for reading uploaded schedules (Practice -> Import from a file).
# Server-only: never prefix with NEXT_PUBLIC_. Get one at console.anthropic.com.
ANTHROPIC_API_KEY=

# ElevenLabs (elevenlabs.io) for Gameday PA: AI walk-up songs, the announcer's voice and
# soundboard sounds. Server-only. The voice ID is optional (pick a stadium-announcer voice
# from ElevenLabs' Voice Library; leave empty for the default).
ELEVENLABS_API_KEY=
ELEVENLABS_ANNOUNCER_VOICE_ID=

# Stripe (stripe.com) for paying for a season: clubs ($99/team) and single teams ($129).
# Server-only. Use test keys (sk_test_...) until you're ready to take real payments.
STRIPE_SECRET_KEY=
# From the webhook endpoint you add in Stripe for https://<your site>/api/stripe/webhook
# (event: checkout.session.completed and checkout.session.async_payment_succeeded).
STRIPE_WEBHOOK_SECRET=
# Supabase service role key (Project Settings -> API). Server-only, used only to record
# payments Stripe confirms. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps (console.cloud.google.com): game locations. Two keys:
# - Server key, restricted to "Places API (New)" only. Never NEXT_PUBLIC_.
GOOGLE_MAPS_API_KEY=
# - Browser key for the map on a game, restricted to "Maps Embed API" and to your site
#   (HTTP referrers https://fungo.team/* and https://www.fungo.team/*). Public by design.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=


# Push notifications (Chatter, Coach Chatter). Make a pair once with:
#   npx web-push generate-vapid-keys
# The public key goes to the browser; the private key stays on the server. Changing them
# later means everyone turns notifications on again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who push services can contact about these notifications.
VAPID_SUBJECT=mailto:support@rallycap.team

# GIFs in Chatter (GIPHY, server-only; searches are G-rated). Get one at developers.giphy.com:
# Create an App, choose API. A new key is a beta key (100 searches an hour); ask GIPHY for a
# production key before many teams use GIFs.
GIPHY_API_KEY=
